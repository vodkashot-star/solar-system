{
  "name": "solar-system",
  "version": "1.3.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bash scripts/copy-draco.sh && NODE_ENV=development concurrently \"tsx server/index-dev.ts\" \"npm run ai:serve\"",
    "build": "bash scripts/copy-draco.sh && vite build && esbuild server/index-prod.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:cf": "bash scripts/copy-draco.sh && vite build",
    "deploy:surge": "npm run build:cf && surge dist/ solar-system-3d.surge.sh",
    "start": "NODE_ENV=production concurrently \"node dist/index-prod.js\" \"npm run ai:serve\"",
    "validate": "npm run typecheck && vitest run",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "models:convert": "bash scripts/convert_nasa_model.sh",
    "models:fetch": "bash scripts/fetch-nasa-planets.sh",
    "models:validate": "bash scripts/validate_glb.sh",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "npm run db:generate && npm run db:push",
    "db:studio": "drizzle-kit studio",
    "ai:serve": "cd spaceAI && ./venv/bin/python run.py serve",
    "ai:train": "cd spaceAI && ./venv/bin/python run.py train",
    "ai:train-regression": "cd spaceAI && ./venv/bin/python run.py train-regression",
    "ai:retrain": "cd spaceAI && ./venv/bin/python run.py retrain",
    "ai:cv": "cd spaceAI && ./venv/bin/python run.py cv",
    "ai:check": "cd spaceAI && ./venv/bin/python ../scripts/validate_models.py",
    "ai:test": "cd spaceAI && ./venv/bin/python -m pytest tests/ -v"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "astronomy-engine": "^2.1.19",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "maath": "^0.10.8",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.170.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.11.1",
    "obj2gltf": "^3.2.0",
    "postcss": "^8.5.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "surge": "^0.41.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.5",
    "typescript": "5.6.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
