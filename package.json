{
  "name": "solar-system",
  "version": "1.2.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index-dev.ts",
    "dev:full": "bash scripts/dev.sh",
    "build": "bash scripts/copy-draco.sh && vite build && esbuild server/index-prod.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:cf": "bash scripts/copy-draco.sh && vite build",
    "start": "NODE_ENV=production node dist/index-prod.js",
    "validate": "tsc && vitest run",
    "check": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "models:convert": "bash scripts/convert_nasa_model.sh",
    "models:validate": "python3 scripts/validate_models.py",
    "models:generate": "blender --background --python scripts/generate_celestial_models.py",
    "models:draco": "for f in client/public/models/*.glb; do npx gltf-transform draco \"$f\" \"$f.tmp\" --encode-speed 10 && mv \"$f.tmp\" \"$f\"; done",
    "models:downscale": "bash scripts/downscale-textures.sh",
    "models:build": "npm run models:generate && npm run models:draco && npm run models:downscale",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "npm run db:generate && npm run db:push",
    "db:studio": "drizzle-kit studio",
    "ai:serve": "cd spaceAI && python run.py serve",
    "ai:train": "cd spaceAI && python run.py train",
    "ai:train-regression": "cd spaceAI && python run.py train-regression",
    "ai:train-all": "cd spaceAI && python run.py train && python run.py train-regression",
    "ai:retrain": "cd spaceAI && python run.py retrain",
    "ai:test": "cd spaceAI && python -m pytest tests/ -v"
  },
  "dependencies": {
